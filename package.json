    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.14"
  }
}
